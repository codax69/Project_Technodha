{
	"info": {
		"_postman_id": "technodha-task1-postman-collection",
		"name": "TECHNODHA - Product Inventory & Order Management API",
		"description": "Postman API Collection for TECHNODHA Technical Assessment Task 1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"customer_john\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] }
					}
				},
				{
					"name": "Login (Obtain JWT)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"customer_john\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] }
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/auth/me/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me", ""] }
					}
				}
			]
		},
		{
			"name": "Products & Categories",
			"item": [
				{
					"name": "List Products (Search & Filter)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products/?search=laptop&page=1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products", ""],
							"query": [
								{ "key": "search", "value": "laptop" },
								{ "key": "page", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Create Product (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"UltraBook Pro 15\",\n  \"description\": \"High performance laptop\",\n  \"price\": \"1499.99\",\n  \"stock_quantity\": 15,\n  \"category\": 1\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/products/", "host": ["{{baseUrl}}"], "path": ["api", "products", ""] }
					}
				},
				{
					"name": "Direct Stock Update (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"stock_quantity\": 50\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/products/1/stock/", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "stock", ""] }
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Place Order (Atomic Stock Lock)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2 }\n  ]\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/orders/", "host": ["{{baseUrl}}"], "path": ["api", "orders", ""] }
					}
				},
				{
					"name": "Get Order History (Isolated User View)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/orders/", "host": ["{{baseUrl}}"], "path": ["api", "orders", ""] }
					}
				},
				{
					"name": "Cancel Pending Order (Atomic Restock)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/orders/1/cancel/", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1", "cancel", ""] }
					}
				},
				{
					"name": "Get Dashboard Metrics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/orders/dashboard/", "host": ["{{baseUrl}}"], "path": ["api", "orders", "dashboard", ""] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000" },
		{ "key": "access_token", "value": "" },
		{ "key": "admin_token", "value": "" }
	]
}
